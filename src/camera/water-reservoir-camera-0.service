[Unit]
Description=Camera capture service for Camera 0 (observing the water-meter)
After=multi-user.target

[Service]
Type=simple
User=pi
Group=pi
# Adjust path and commandline-arguments!
WorkingDirectory=/home/pi/water-reservoir-monitoring/src/camera
ExecStart=/usr/bin/env python3 -m camera --device=0 --redis-server=127.0.0.1 --camera-number 0 --log-level=info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target