[Unit]
Description=Data-Collector-Service for Water Reservoir Monitoring
After=multi-user.target

[Service]
Type=simple
User=pi
Group=pi
# Adjust path and commandline-arguments!
WorkingDirectory=/home/pi/water-reservoir-monitoring/src/data-collector/
ExecStart=/usr/bin/env python3 -m data_collector --camera-images-folder=/home/pi/water-reservoir-monitoring/data/camera-images --water-level-csv-file=/home/pi/water-reservoir-monitoring/data/water-level/sensor-data.csv --water-meter-csv-file=/home/pi/water-reservoir-monitoring/data/water-meter/sensor-data.csv --redis-server=127.0.0.1 --log-level=info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target